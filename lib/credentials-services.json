{
  "anthropic": {
    "env": ["ANTHROPIC_API_KEY"],
    "domains": ["api.anthropic.com", "console.anthropic.com", "claude.ai"],
    "header": "x-api-key",
    "format": "%s"
  },
  "openai": {
    "env": ["OPENAI_API_KEY"],
    "domains": ["api.openai.com", "openai.com"],
    "header": "Authorization",
    "format": "Bearer %s"
  },
  "github": {
    "env": ["GH_TOKEN", "GITHUB_TOKEN"],
    "domains": ["api.github.com", "github.com", "raw.githubusercontent.com", "gist.github.com"],
    "header": "Authorization",
    "format": "Bearer %s"
  },
  "google": {
    "env": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
    "domains": ["generativelanguage.googleapis.com", "aiplatform.googleapis.com"],
    "header": "x-goog-api-key",
    "format": "%s"
  },
  "groq": {
    "env": ["GROQ_API_KEY"],
    "domains": ["api.groq.com"],
    "header": "Authorization",
    "format": "Bearer %s"
  },
  "openrouter": {
    "env": ["OPENROUTER_API_KEY"],
    "domains": ["openrouter.ai"],
    "header": "Authorization",
    "format": "Bearer %s"
  },
  "xai": {
    "env": ["XAI_API_KEY"],
    "domains": ["api.x.ai"],
    "header": "Authorization",
    "format": "Bearer %s"
  },
  "mistral": {
    "env": ["MISTRAL_API_KEY"],
    "domains": ["api.mistral.ai"],
    "header": "Authorization",
    "format": "Bearer %s"
  }
}
