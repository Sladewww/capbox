#!/usr/bin/env bash
# =============================================================================
# CapBox CLI 入口
#
# 用法：.capbox/bin/capbox <command> [options] [-- args]
#
# 本文件只负责：定位根目录 -> source 各库 -> 命令分发。
# 具体实现分别在 lib/common.sh（基础）、lib/rootfs.sh（init/镜像）、
# lib/sandbox.sh（exec/shell/cp/ls/ps/pkg）、lib/daemon.sh（up/down/status/logs）。
# =============================================================================

set -u

# ---------- 0. 定位 CapBox 根目录 --------------------------------------------
# 规则：
#   1) CAPBOX_ROOT / --root → 工作区根下的 .capbox/（可尚不存在）
#   2) 从 $PWD 向上查找已有 .capbox/（含 lib 或 bin）
#   3) 否则：状态目标 = $PWD/.capbox，库从 CLI 模板树加载（可随后 bootstrap/init）
#      若 $PWD 已在模板树内，则 CAPBOX_DIR=模板本身（开发/仓库即安装）
# 全局 --root/--debug 必须在锁定 CAPBOX_DIR 之前解析。
# 尽早加载共享目录，使下面尚未 source common.sh 的错误也能按 CAPBOX_LANG / locale 输出。
_capbox_self="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
_capbox_bin_dir="$(cd -- "$(dirname -- "$_capbox_self")" && pwd)"
_CAPBOX_CLI_BIN_DIR="$_capbox_bin_dir"
export _CAPBOX_CLI_BIN_DIR

# 合法 CAPBOX_LANG 或 locale 预解析；非法值仍等到 load_config 之后再以固定中英各一句退出。
if [ -f "$_CAPBOX_CLI_BIN_DIR/../lib/i18n.sh" ]; then
  # shellcheck source=/dev/null
  . "$_CAPBOX_CLI_BIN_DIR/../lib/i18n.sh"
fi

# 目录尚不可用时的语言选择，规则与 _capbox_resolve_lang_preview 一致（非法 CAPBOX_LANG 视为未采用，默认英文）。
_capbox_early_lang() {
  local raw s
  if [ -n "${CAPBOX_LANG:-}" ]; then
    raw="$CAPBOX_LANG"
    s="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
    s="${s%%@*}"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    case "$s" in
      zh|zh.*|zh_cn|zh_cn.*) printf 'zh'; return 0 ;;
      en|en.*|en_*) printf 'en'; return 0 ;;
    esac
    printf 'en'
    return 0
  fi
  if [ -n "${LC_ALL:-}" ]; then
    raw="$LC_ALL"
  elif [ -n "${LC_MESSAGES:-}" ]; then
    raw="$LC_MESSAGES"
  else
    raw="${LANG:-}"
  fi
  s="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  s="${s%%@*}"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  case "$s" in
    zh|zh.*|zh_cn|zh_cn.*) printf 'zh' ;;
    *) printf 'en' ;;
  esac
}

# 无目录可加载时（例如 CLI 旁没有 lib/）按同一套语言规则吐出固定中/英文，避免只剩中文。
_capbox_early_fmt() {
  local key="${1-}" lang v
  shift || true
  if declare -F i18n_fmt >/dev/null 2>&1; then
    i18n_fmt "$key" "$@"
    return 0
  fi
  lang="$(_capbox_early_lang)"
  case "$key:$lang" in
    cli.ignore_allow_old_bwrap:zh) v='忽略环境变量 CAPBOX_ALLOW_OLD_BWRAP={value}；持久放行写入 config.env，单次放行用 --allow-old-bwrap' ;;
    cli.ignore_allow_old_bwrap:*) v='Ignoring environment variable CAPBOX_ALLOW_OLD_BWRAP={value}; write a persistent allow to config.env, or pass --allow-old-bwrap for a one-shot allow' ;;
    cli.root_missing_arg:zh) v='--root 需要参数（工作区路径）' ;;
    cli.root_missing_arg:*) v='--root requires an argument (workspace path)' ;;
    cli.template_not_found:zh) v='找不到 CapBox 模板（CLI 旁无 lib/）；请安装 CapBox 或用项目内 .capbox/bin/capbox' ;;
    cli.template_not_found:*) v='CapBox template not found (no lib/ next to the CLI); install CapBox or use a project-local .capbox/bin/capbox' ;;
    cli.root_not_found:zh) v='找不到 CapBox 根目录（.capbox）；请在项目下运行 capbox init，或设置 CAPBOX_ROOT=/path/to/project' ;;
    cli.root_not_found:*) v='CapBox root directory (.capbox) not found; run capbox init from a project, or set CAPBOX_ROOT=/path/to/project' ;;
    cli.upgrade_incomplete:zh) v='运行文件升级未完成；请用完整模板运行 upgrade rollback' ;;
    cli.upgrade_incomplete:*) v='A runtime file upgrade did not finish; run upgrade rollback with a complete template' ;;
    cli.cannot_load_common:zh) v='无法加载 {dir}/common.sh' ;;
    cli.cannot_load_common:*) v='Unable to load {dir}/common.sh' ;;
    cli.incomplete_install:zh) v='安装不完整，缺少 {dir}/{module}.sh' ;;
    cli.incomplete_install:*) v='Incomplete install, missing {dir}/{module}.sh' ;;
    *) v="$key" ;;
  esac
  local pair k val
  for pair in "$@"; do
    k="${pair%%=*}"
    val="${pair#*=}"
    v="${v//\{$k\}/$val}"
  done
  printf '%s' "$v"
}

_capbox_early_err() {
  local prefix text
  text="$(_capbox_early_fmt "$@")"
  if [ -n "${_CAPBOX_LOG_PREFIX_ERR:-}" ]; then
    prefix="$_CAPBOX_LOG_PREFIX_ERR"
  elif [ "$(_capbox_early_lang)" = zh ]; then
    prefix='[capbox] 错误:'
  else
    prefix='[capbox] error:'
  fi
  printf '%s %s
' "$prefix" "$text" >&2
}

_capbox_early_warn() {
  local prefix text
  text="$(_capbox_early_fmt "$@")"
  if [ -n "${_CAPBOX_LOG_PREFIX_WARN:-}" ]; then
    prefix="$_CAPBOX_LOG_PREFIX_WARN"
  elif [ "$(_capbox_early_lang)" = zh ]; then
    prefix='[capbox] 警告:'
  else
    prefix='[capbox] warning:'
  fi
  printf '%s %s
' "$prefix" "$text" >&2
}

# 继承来的环境变量不能打开旧版 bwrap 放行。单次标记只来自本次 argv。
if [ -n "${CAPBOX_ALLOW_OLD_BWRAP+x}" ]; then
  _capbox_early_warn cli.ignore_allow_old_bwrap value="$CAPBOX_ALLOW_OLD_BWRAP"
  unset CAPBOX_ALLOW_OLD_BWRAP
fi
unset CAPBOX_ALLOW_OLD_BWRAP_ONCE

# 剥掉影响根目录选择的全局选项；其余参数原样留给 capbox_main
_capbox_argv=()
while [ $# -gt 0 ]; do
  case "$1" in
    --debug)
      export CAPBOX_DEBUG=1
      shift
      ;;
    --root)
      if [ $# -lt 2 ]; then
        _capbox_early_err cli.root_missing_arg
        exit 2
      fi
      export CAPBOX_ROOT="$2"
      shift 2
      ;;
    --root=*)
      export CAPBOX_ROOT="${1#*=}"
      shift
      ;;
    --allow-old-bwrap)
      CAPBOX_ALLOW_OLD_BWRAP_ONCE=1
      export CAPBOX_ALLOW_OLD_BWRAP_ONCE
      shift
      ;;
    --)
      _capbox_argv+=("$@")
      break
      ;;
    *)
      _capbox_argv+=("$@")
      break
      ;;
  esac
done
set -- "${_capbox_argv[@]}"
unset _capbox_argv

# 解析 CAPBOX_DIR / CAPBOX_WORKSPACE（可在 --root 后再次调用）
# 模板树：CLI 自带的 bin+lib（可装在 PATH）；状态树：当前项目的 .capbox/
# 二者分离 —— 没有项目 .capbox 时不要把模板目录当成 CAPBOX_DIR（否则会 HOME bind）。
_capbox_cli_template_dir() {
  local t
  t="$(cd -- "$_CAPBOX_CLI_BIN_DIR/.." 2>/dev/null && pwd || true)"
  if [ -n "$t" ] && [ -f "$t/lib/common.sh" ]; then
    printf '%s\n' "$t"
    return 0
  fi
  return 1
}

_capbox_resolve_install_dir() {
  local root probe cand template ws
  CAPBOX_DIR=""
  _CAPBOX_TEMPLATE_DIR=""
  template="$(_capbox_cli_template_dir 2>/dev/null || true)"
  if [ -n "$template" ]; then
    _CAPBOX_TEMPLATE_DIR="$template"
    export _CAPBOX_TEMPLATE_DIR
  fi

  if [ -n "${CAPBOX_ROOT:-}" ]; then
    root="$(cd -- "$CAPBOX_ROOT" 2>/dev/null && pwd || printf '%s' "$CAPBOX_ROOT")"
    if [ -d "$root/.capbox" ] && { [ -d "$root/.capbox/lib" ] || [ -e "$root/.capbox/bin/capbox" ]; }; then
      CAPBOX_DIR="$(cd -- "$root/.capbox" && pwd)"
    else
      # 允许 CAPBOX_ROOT 指向尚未脚手架/init 的工作区
      CAPBOX_DIR="$root/.capbox"
    fi
    CAPBOX_WORKSPACE="$root"
  else
    probe="$PWD"
    while [ -n "$probe" ] && [ "$probe" != "/" ]; do
      cand="$probe/.capbox"
      if [ -d "$cand/lib" ] || [ -e "$cand/bin/capbox" ]; then
        CAPBOX_DIR="$(cd -- "$cand" 2>/dev/null && pwd || printf '%s' "$cand")"
        CAPBOX_WORKSPACE="$(cd -- "$probe" 2>/dev/null && pwd || printf '%s' "$probe")"
        break
      fi
      probe="$(dirname -- "$probe")"
    done
    if [ -z "${CAPBOX_DIR:-}" ]; then
      if [ -z "$template" ]; then
        _capbox_early_err cli.template_not_found
        exit 1
      fi
      # 仅当 cwd 正好是模板根（开发/「仓库即安装」）时用模板当状态目录；
      # 子目录（含 test/tmp）一律落到 $PWD/.capbox，避免污染模板树。
      if [ "$PWD" = "$template" ]; then
        # 开发树「仓库即状态」：工作区就是模板根，绝不能 dirname 成 /workspace
        CAPBOX_DIR="$template"
        CAPBOX_WORKSPACE="$template"
      else
        ws="$(cd -- "$PWD" 2>/dev/null && pwd || printf '%s' "$PWD")"
        CAPBOX_DIR="$ws/.capbox"
        CAPBOX_WORKSPACE="$ws"
      fi
    fi
  fi
  if [ -z "${CAPBOX_DIR:-}" ]; then
    _capbox_early_err cli.root_not_found
    exit 1
  fi
  export CAPBOX_DIR
  export CAPBOX_WORKSPACE
}

# bootstrap / 显式新建：不要「借用」上级目录已有的 .capbox（否则在项目子目录里
# bootstrap 会静默写到父项目）。--root 已在上面处理。
_capbox_force_local_state=0
case "${1:-}" in
  bootstrap) _capbox_force_local_state=1 ;;
esac

_capbox_resolve_install_dir
if [ "${_capbox_force_local_state:-0}" = 1 ] && [ -z "${CAPBOX_ROOT:-}" ]; then
  _ws="$(cd -- "$PWD" 2>/dev/null && pwd || printf '%s' "$PWD")"
  # 仅当解析结果不是「本目录的 .capbox」时纠正
  _want="$_ws/.capbox"
  if [ "${CAPBOX_DIR:-}" != "$_want" ]; then
    CAPBOX_DIR="$_want"
    CAPBOX_WORKSPACE="$_ws"
    export CAPBOX_DIR CAPBOX_WORKSPACE
  fi
fi
unset _capbox_force_local_state _ws _want
unset _capbox_self _capbox_bin_dir

# 中断的升级必须用完整的外部模板恢复。
if [[ -e "$CAPBOX_DIR/.upgrade-in-progress" && "${1:-}" != upgrade ]]; then
  _capbox_early_err cli.upgrade_incomplete
  exit 1
fi

# ---------- 1. source 各库（契约 §4 固定顺序，缺文件则跳过） ------------------
# 优先从「当前 CAPBOX_DIR」加载；若该树尚不完整（仅有空 .capbox），回退到 CLI 自带的 lib。
_capbox_lib_dir="$CAPBOX_DIR/lib"
if [ ! -f "$_capbox_lib_dir/common.sh" ]; then
  if [ -f "$_CAPBOX_CLI_BIN_DIR/../lib/common.sh" ]; then
    _capbox_lib_dir="$(cd -- "$_CAPBOX_CLI_BIN_DIR/../lib" && pwd)"
  fi
fi

if [[ "${1:-}" == upgrade || "${1:-}" == setup ]]; then
  _capbox_lib_dir="$(cd -- "$_CAPBOX_CLI_BIN_DIR/../lib" && pwd)"
fi

# shellcheck source=/dev/null
source "$_capbox_lib_dir/common.sh" || {
  _capbox_early_err cli.cannot_load_common dir="$_capbox_lib_dir"
  exit 1
}
for _capbox_module in rootfs sandbox daemon net resources recipe idmap service audit security landlock fsguard image package-lock upgrade envkit credentials; do
  if [[ ! -f "$_capbox_lib_dir/$_capbox_module.sh" ]]; then
    _capbox_early_err cli.incomplete_install dir="$_capbox_lib_dir" module="$_capbox_module"
    exit 5
  fi
  # shellcheck source=/dev/null
  source "$_capbox_lib_dir/$_capbox_module.sh" || exit $?
done
unset _capbox_module
[ -f "$_capbox_lib_dir/agent.sh" ] && source "$_capbox_lib_dir/agent.sh"
unset _capbox_lib_dir

# ---------- 2. 帮助 -----------------------------------------------------------

capbox_usage() {
  i18n_print help.main
}

# ---------- 3. 命令表 ---------------------------------------------------------

# 命令是否存在（函数形式）
_has_cmd_fn() { declare -F "$1" >/dev/null 2>&1; }

# 统一分发；每个命令失败只影响自己的退出码
_require_decl() {
  local fn="${1:-}" label="${2:-$1}" hint="${3:-}"
  if ! _has_cmd_fn "$fn"; then
    if [[ -n "$hint" ]]; then
      i18n_err cli.cmd_unavailable_hint label="$label" fn="$fn" hint="$hint"
    else
      i18n_err cli.cmd_unavailable label="$label" fn="$fn"
    fi
    return 1
  fi
  return 0
}

# 在 CAPBOX_ROOT / 工作区变更后重绑路径并重新加载 config.env
_capbox_rebind_after_root() {
  _capbox_resolve_install_dir
  if declare -F load_config >/dev/null 2>&1; then
    load_config
  elif declare -F _capbox_derive_paths >/dev/null 2>&1; then
    # resolve 已设 CAPBOX_WORKSPACE；此处仅兜底，规则与 common.sh 一致
    if [ -z "${CAPBOX_WORKSPACE:-}" ]; then
      if [ "$(basename -- "$CAPBOX_DIR")" = ".capbox" ]; then
        CAPBOX_WORKSPACE="$(cd -- "$(dirname -- "$CAPBOX_DIR")" && pwd)"
      else
        CAPBOX_WORKSPACE="$CAPBOX_DIR"
      fi
      export CAPBOX_WORKSPACE
    fi
    _capbox_derive_paths
  fi
}

capbox_main() {
  local cmd=""
  local root_changed=0
  # 跳过全局选项（--root/--debug 已在入口预处理；此处再认一次以支持
  # `capbox <cmd>` 之前的重复书写，并在此时真正重绑 CAPBOX_DIR）
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help | help) capbox_usage; return 0 ;;
      --version | -V) cmd_version; return 0 ;;
      --debug) export CAPBOX_DEBUG=1; shift ;;
      --root)
        export CAPBOX_ROOT="${2:-}"
        root_changed=1
        shift 2 || shift
        ;;
      --root=*)
        export CAPBOX_ROOT="${1#*=}"
        root_changed=1
        shift
        ;;
      --allow-old-bwrap)
        CAPBOX_ALLOW_OLD_BWRAP_ONCE=1
        export CAPBOX_ALLOW_OLD_BWRAP_ONCE
        shift
        ;;
      --) shift; break ;;
      -*) i18n_err cli.unknown_global_option arg="$1"; capbox_usage >&2; return 2 ;;
      *) cmd="$1"; shift; break ;;
    esac
  done

  if (( root_changed )); then
    _capbox_rebind_after_root
  fi

  if [ -z "$cmd" ]; then
    capbox_usage
    return 0
  fi

  # 危险操作：禁止把 $HOME 或 / 当成工作区 RW bind 进容器
  case "$cmd" in
    bootstrap | init | upgrade | setup | bundle | mcp | task | policy | secret | exec | run | do | shell | up | cp | pkg | ls | ps | recipe | service | snapshot | image | audit | metrics | doctor)
      if declare -F _capbox_require_safe_workspace >/dev/null 2>&1; then
        _capbox_require_safe_workspace || return 1
      fi
      ;;
  esac

  case "$cmd" in
    # ---- 生命周期 ----
    bootstrap)
      _require_decl cmd_bootstrap bootstrap || return 1
      cmd_bootstrap "$@"
      ;;
    upgrade)
      cmd_upgrade "$@"
      ;;
    init)
      _require_decl cmd_init init || return 1
      cmd_init "$@"
      ;;
    status)
      # 优先用 daemon.sh 提供的 cmd_status（它会补充 daemon 详情）；
      # 缺失时用 common.sh 的 status_oneshot 兜底（daemon.running 如实反映）。
      if _has_cmd_fn cmd_status; then
        cmd_status "$@"
      else
        status_oneshot "$@"
      fi
      ;;
    doctor)
      _require_decl cmd_doctor doctor || return 1
      cmd_doctor "$@"
      ;;
    clean)
      _require_decl cmd_clean clean || return 1
      cmd_clean "$@"
      ;;

    # ---- 执行 ----
    setup) cmd_setup "$@" ;;
    bundle) cmd_bundle "$@" ;;
    mcp) cmd_mcp "$@" ;;
    task) cmd_task "$@" ;;
    policy) cmd_policy "$@" ;;
    exec)
      _require_decl cmd_exec exec "lib/sandbox.sh" || return 1
      cmd_exec "$@"
      ;;
    run | do)
      # 便捷别名：capbox run -- id -u
      _require_decl cmd_exec exec "lib/sandbox.sh" || return 1
      cmd_exec "$@"
      ;;
    shell | sh)
      _require_decl cmd_shell shell "lib/sandbox.sh" || return 1
      cmd_shell "$@"
      ;;
    ls)
      _require_decl cmd_ls ls "lib/sandbox.sh" || return 1
      cmd_ls "$@"
      ;;
    ps)
      _require_decl cmd_ps ps "lib/sandbox.sh" || return 1
      cmd_ps "$@"
      ;;

    # ---- 常驻容器（由 lib/daemon.sh 提供） ----
    up)
      _require_decl cmd_up up "$(i18n_fmt cli.module_not_ready module=lib/daemon.sh)" || return 3
      cmd_up "$@"
      ;;
    down)
      _require_decl cmd_down down "$(i18n_fmt cli.module_not_ready module=lib/daemon.sh)" || return 3
      cmd_down "$@"
      ;;
    logs)
      _require_decl cmd_logs logs "$(i18n_fmt cli.module_not_ready module=lib/daemon.sh)" || return 3
      cmd_logs "$@"
      ;;

    # ---- 文件与包 ----
    cp)
      _require_decl cmd_cp cp "lib/sandbox.sh" || return 1
      cmd_cp "$@"
      ;;
    pkg)
      _require_decl cmd_pkg pkg "lib/sandbox.sh" || return 1
      cmd_pkg "$@"
      ;;

    # ---- 信息与配置 ----
    distros)
      _require_decl cmd_distros distros || return 1
      cmd_distros "$@"
      ;;
    config)
      _require_decl cmd_config config || return 1
      cmd_config "$@"
      ;;
    recipe)
      _require_decl cmd_recipe recipe "lib/recipe.sh" || return 1
      cmd_recipe "$@"
      ;;
    service)
      _require_decl cmd_service service "lib/service.sh" || return 1
      cmd_service "$@"
      ;;
    snapshot)
      _require_decl cmd_snapshot snapshot "lib/fsguard.sh" || return 1
      cmd_snapshot "$@"
      ;;
    image)
      _require_decl cmd_image image "lib/image.sh" || return 1
      cmd_image "$@"
      ;;
    secret)
      _require_decl cmd_secret secret "lib/credentials.sh" || return 1
      cmd_secret "$@"
      ;;
    audit)
      _require_decl cmd_audit audit "lib/audit.sh" || return 1
      cmd_audit "$@"
      ;;
    metrics)
      _require_decl cmd_metrics metrics "lib/audit.sh" || return 1
      cmd_metrics "$@"
      ;;
    version | --version)
      cmd_version
      ;;
    *)
      i18n_err cli.unknown_command cmd="$cmd"
      printf '\n' >&2
      capbox_usage >&2
      return 2
      ;;
  esac
}

capbox_main "$@"
exit $?
