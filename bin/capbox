#!/usr/bin/env bash
# =============================================================================
# CapBox CLI 入口
#
# 用法：.capbox/bin/capbox <command> [options] [-- args]
#
# 本文件只负责：定位根目录 -> source 各库 -> 命令分发。
# 具体实现分别在 lib/common.sh（基础）、lib/rootfs.sh（init/镜像）、
# lib/sandbox.sh（exec/shell/cp/ls/ps/pkg）、lib/daemon.sh（up/down/status/logs）。
# =============================================================================

set -u

# ---------- 0. 定位 CapBox 根目录 --------------------------------------------
# 规则：
#   1) CAPBOX_ROOT / --root → 工作区根下的 .capbox/（可尚不存在）
#   2) 从 $PWD 向上查找已有 .capbox/（含 lib 或 bin）
#   3) 否则：状态目标 = $PWD/.capbox，库从 CLI 模板树加载（可随后 bootstrap/init）
#      若 $PWD 已在模板树内，则 CAPBOX_DIR=模板本身（开发/仓库即安装）
# 全局 --root/--debug 必须在锁定 CAPBOX_DIR 之前解析。
_capbox_self="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
_capbox_bin_dir="$(cd -- "$(dirname -- "$_capbox_self")" && pwd)"
_CAPBOX_CLI_BIN_DIR="$_capbox_bin_dir"
export _CAPBOX_CLI_BIN_DIR

# 剥掉影响根目录选择的全局选项；其余参数原样留给 capbox_main
_capbox_argv=()
while [ $# -gt 0 ]; do
  case "$1" in
    --debug)
      export CAPBOX_DEBUG=1
      shift
      ;;
    --root)
      if [ $# -lt 2 ]; then
        printf '[capbox] 错误: --root 需要参数（工作区路径）\n' >&2
        exit 2
      fi
      export CAPBOX_ROOT="$2"
      shift 2
      ;;
    --root=*)
      export CAPBOX_ROOT="${1#*=}"
      shift
      ;;
    --)
      _capbox_argv+=("$@")
      break
      ;;
    *)
      _capbox_argv+=("$@")
      break
      ;;
  esac
done
set -- "${_capbox_argv[@]}"
unset _capbox_argv

# 解析 CAPBOX_DIR / CAPBOX_WORKSPACE（可在 --root 后再次调用）
# 模板树：CLI 自带的 bin+lib（可装在 PATH）；状态树：当前项目的 .capbox/
# 二者分离 —— 没有项目 .capbox 时不要把模板目录当成 CAPBOX_DIR（否则会 HOME bind）。
_capbox_cli_template_dir() {
  local t
  t="$(cd -- "$_CAPBOX_CLI_BIN_DIR/.." 2>/dev/null && pwd || true)"
  if [ -n "$t" ] && [ -f "$t/lib/common.sh" ]; then
    printf '%s\n' "$t"
    return 0
  fi
  return 1
}

_capbox_resolve_install_dir() {
  local root probe cand template ws
  CAPBOX_DIR=""
  _CAPBOX_TEMPLATE_DIR=""
  template="$(_capbox_cli_template_dir 2>/dev/null || true)"
  if [ -n "$template" ]; then
    _CAPBOX_TEMPLATE_DIR="$template"
    export _CAPBOX_TEMPLATE_DIR
  fi

  if [ -n "${CAPBOX_ROOT:-}" ]; then
    root="$(cd -- "$CAPBOX_ROOT" 2>/dev/null && pwd || printf '%s' "$CAPBOX_ROOT")"
    if [ -d "$root/.capbox" ] && { [ -d "$root/.capbox/lib" ] || [ -e "$root/.capbox/bin/capbox" ]; }; then
      CAPBOX_DIR="$(cd -- "$root/.capbox" && pwd)"
    else
      # 允许 CAPBOX_ROOT 指向尚未脚手架/init 的工作区
      CAPBOX_DIR="$root/.capbox"
    fi
    CAPBOX_WORKSPACE="$root"
  else
    probe="$PWD"
    while [ -n "$probe" ] && [ "$probe" != "/" ]; do
      cand="$probe/.capbox"
      if [ -d "$cand/lib" ] || [ -e "$cand/bin/capbox" ]; then
        CAPBOX_DIR="$(cd -- "$cand" 2>/dev/null && pwd || printf '%s' "$cand")"
        CAPBOX_WORKSPACE="$(cd -- "$probe" 2>/dev/null && pwd || printf '%s' "$probe")"
        break
      fi
      probe="$(dirname -- "$probe")"
    done
    if [ -z "${CAPBOX_DIR:-}" ]; then
      if [ -z "$template" ]; then
        printf '[capbox] 错误: 找不到 CapBox 模板（CLI 旁无 lib/）；请安装 CapBox 或用项目内 .capbox/bin/capbox\n' >&2
        exit 1
      fi
      # 仅当 cwd 正好是模板根（开发/「仓库即安装」）时用模板当状态目录；
      # 子目录（含 test/tmp）一律落到 $PWD/.capbox，避免污染模板树。
      if [ "$PWD" = "$template" ]; then
        CAPBOX_DIR="$template"
        CAPBOX_WORKSPACE="$(cd -- "$(dirname -- "$template")" 2>/dev/null && pwd || dirname -- "$template")"
      else
        ws="$(cd -- "$PWD" 2>/dev/null && pwd || printf '%s' "$PWD")"
        CAPBOX_DIR="$ws/.capbox"
        CAPBOX_WORKSPACE="$ws"
      fi
    fi
  fi
  if [ -z "${CAPBOX_DIR:-}" ]; then
    printf '[capbox] 错误: 找不到 CapBox 根目录（.capbox）；请在项目下运行 capbox init，或设置 CAPBOX_ROOT=/path/to/project\n' >&2
    exit 1
  fi
  export CAPBOX_DIR
  export CAPBOX_WORKSPACE
}

_capbox_resolve_install_dir
unset _capbox_self _capbox_bin_dir

# ---------- 1. source 各库（契约 §4 固定顺序，缺文件则跳过） ------------------
# 优先从「当前 CAPBOX_DIR」加载；若该树尚不完整（仅有空 .capbox），回退到 CLI 自带的 lib。
_capbox_lib_dir="$CAPBOX_DIR/lib"
if [ ! -f "$_capbox_lib_dir/common.sh" ]; then
  if [ -f "$_CAPBOX_CLI_BIN_DIR/../lib/common.sh" ]; then
    _capbox_lib_dir="$(cd -- "$_CAPBOX_CLI_BIN_DIR/../lib" && pwd)"
  fi
fi

# shellcheck source=/dev/null
source "$_capbox_lib_dir/common.sh" || {
  printf '[capbox] 错误: 无法加载 %s/common.sh\n' "$_capbox_lib_dir" >&2
  exit 1
}
# shellcheck source=/dev/null
[ -f "$_capbox_lib_dir/rootfs.sh" ] && source "$_capbox_lib_dir/rootfs.sh"
# shellcheck source=/dev/null
[ -f "$_capbox_lib_dir/sandbox.sh" ] && source "$_capbox_lib_dir/sandbox.sh"
# shellcheck source=/dev/null
[ -f "$_capbox_lib_dir/daemon.sh" ] && source "$_capbox_lib_dir/daemon.sh"
# shellcheck source=/dev/null
[ -f "$_capbox_lib_dir/net.sh" ] && source "$_capbox_lib_dir/net.sh"
# shellcheck source=/dev/null
[ -f "$_capbox_lib_dir/resources.sh" ] && source "$_capbox_lib_dir/resources.sh"
# shellcheck source=/dev/null
[ -f "$_capbox_lib_dir/recipe.sh" ] && source "$_capbox_lib_dir/recipe.sh"
unset _capbox_lib_dir

# ---------- 2. 帮助 -----------------------------------------------------------

capbox_usage() {
  cat <<'EOF'
CapBox —— 工作区内持久化的 root Linux 容器

用法: capbox [--root DIR] [--debug] <command> [options] [-- args]

全局选项
  --root DIR                        指定工作区根（其下使用 DIR/.capbox）；等价于 CAPBOX_ROOT
  --debug                           打开调试日志

系统生命周期
  bootstrap                         在当前工作区脚手架 .capbox/（从 PATH 上的模板复制）
  init [--distro alpine|ubuntu] [--force] [--from URL|路径]
                                    脚手架（如需）+ 下载解包 rootfs，注入镜像源，跑首次引导
  status [--json]                   查看 distro / rootfs / daemon / 网络状态
  doctor                            逐项自检（bwrap、userns 全权限、rootfs、镜像源…）
  clean [--all]                     清理缓存与日志；--all 一并删除 rootfs

执行
  exec [--daemon] [--timeout N] [--cwd DIR] [--] CMD...
                                    在容器内执行命令（默认一次性无状态容器）
  shell [--daemon]                  交互式 shell（无 tty 时退化为读取 stdin 的 sh）
  ls [PATH]                         列出容器内目录（默认 /workspace）
  ps                                列出容器内进程

常驻容器（必须用 DSH 后台任务运行 capbox up，前台阻塞）
  up                                启动守护容器
  down                              停止守护容器
  logs [-f] [-n N]                  查看守护容器日志

文件与软件包
  cp SRC DST                        宿主↔容器 拷贝（guest:/path 或 host:/path）
  pkg install|remove|update|list [--] PKG...
                                    按发行版分派到 apk / apt-get

信息与配置
  distros                           列出支持的发行版与镜像 URL
  config get|set|list               读取 / 修改 config.env
  recipe apply|show [FILE]          应用/查看声明式 KEY=value 配方（不 source）
  version                           打印版本
  help, --help, -h                  显示本帮助

网络（CAPBOX_NET）
  none         --unshare-net，容器内无网络
  open (host)  共享宿主网络（默认；host 为兼容别名）
  restricted   --unshare-net + 域名 allowlist 代理（需 python3/nsenter 与 CAPBOX_NET_ALLOW）
               不假装 bwrap 能过滤域名；原始 TCP 无路由，仅 HTTP(S)_PROXY 出站

常用示例
  capbox bootstrap                       # 仅在当前目录生成 .capbox/
  capbox init --distro alpine            # 脚手架 + 首次准备（约 3.4MB 镜像）
  capbox recipe apply                    # 按 capbox.recipe 写配置/init/装包
  capbox exec --net none -- id -u        # 无网络一次性执行
  capbox exec -- id -u                   # 容器内应为 0
  capbox exec -- sh -c 'apk add --no-cache curl'
  capbox pkg install curl                # 等价且自动处理镜像源
  echo 'echo hi' | capbox shell          # 无 tty 时可用

退出码
  0   成功
  1   一般错误（下载失败、内部失败等）
  2   用法错误
  3   守护容器未运行（需要 daemon 的命令）
  4   rootfs 不存在（先运行 capbox init）
  5   依赖缺失（bwrap 等）
  124 容器内命令超时

要点
  * 容器内是 uid 0 且拥有全量 capability，可 mount / 装包 / 起服务。
  * 所有状态持久化在 .capbox/ 内；容器内 /workspace 就是宿主工作区。
  * 常驻容器不能 nohup & 启动（DSH 会杀进程树），只能用后台任务跑 capbox up。
EOF
}

# ---------- 3. 命令表 ---------------------------------------------------------

# 命令是否存在（函数形式）
_has_cmd_fn() { declare -F "$1" >/dev/null 2>&1; }

# 统一分发；每个命令失败只影响自己的退出码
_require_decl() {
  local fn="${1:-}" label="${2:-$1}" hint="${3:-}"
  if ! _has_cmd_fn "$fn"; then
    log_err "命令 '$label' 不可用：缺少实现函数 $fn${hint:+（$hint）}"
    return 1
  fi
  return 0
}

# 在 CAPBOX_ROOT / 工作区变更后重绑路径并重新加载 config.env
_capbox_rebind_after_root() {
  _capbox_resolve_install_dir
  if declare -F load_config >/dev/null 2>&1; then
    load_config
  elif declare -F _capbox_derive_paths >/dev/null 2>&1; then
    CAPBOX_WORKSPACE="$(cd -- "$(dirname -- "$CAPBOX_DIR")" 2>/dev/null && pwd || dirname -- "$CAPBOX_DIR")"
    export CAPBOX_WORKSPACE
    _capbox_derive_paths
  fi
}

capbox_main() {
  local cmd=""
  local root_changed=0
  # 跳过全局选项（--root/--debug 已在入口预处理；此处再认一次以支持
  # `capbox <cmd>` 之前的重复书写，并在此时真正重绑 CAPBOX_DIR）
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help | help) capbox_usage; return 0 ;;
      --version | -V) cmd_version; return 0 ;;
      --debug) export CAPBOX_DEBUG=1; shift ;;
      --root)
        export CAPBOX_ROOT="${2:-}"
        root_changed=1
        shift 2 || shift
        ;;
      --root=*)
        export CAPBOX_ROOT="${1#*=}"
        root_changed=1
        shift
        ;;
      --) shift; break ;;
      -*) log_err "未知全局选项: $1"; capbox_usage >&2; return 2 ;;
      *) cmd="$1"; shift; break ;;
    esac
  done

  if (( root_changed )); then
    _capbox_rebind_after_root
  fi

  if [ -z "$cmd" ]; then
    capbox_usage
    return 0
  fi

  # 危险操作：禁止把 $HOME 或 / 当成工作区 RW bind 进容器
  case "$cmd" in
    bootstrap | init | exec | run | do | shell | up | cp | pkg | ls | ps | recipe)
      if declare -F _capbox_require_safe_workspace >/dev/null 2>&1; then
        _capbox_require_safe_workspace || return 1
      fi
      ;;
  esac

  case "$cmd" in
    # ---- 生命周期 ----
    bootstrap)
      _require_decl cmd_bootstrap bootstrap || return 1
      cmd_bootstrap "$@"
      ;;
    init)
      _require_decl cmd_init init || return 1
      cmd_init "$@"
      ;;
    status)
      # 优先用 daemon.sh 提供的 cmd_status（它会补充 daemon 详情）；
      # 缺失时用 common.sh 的 status_oneshot 兜底（daemon.running 如实反映）。
      if _has_cmd_fn cmd_status; then
        cmd_status "$@"
      else
        status_oneshot "$@"
      fi
      ;;
    doctor)
      _require_decl cmd_doctor doctor || return 1
      cmd_doctor "$@"
      ;;
    clean)
      _require_decl cmd_clean clean || return 1
      cmd_clean "$@"
      ;;

    # ---- 执行 ----
    exec)
      _require_decl cmd_exec exec "lib/sandbox.sh" || return 1
      cmd_exec "$@"
      ;;
    run | do)
      # 便捷别名：capbox run -- id -u
      _require_decl cmd_exec exec "lib/sandbox.sh" || return 1
      cmd_exec "$@"
      ;;
    shell | sh)
      _require_decl cmd_shell shell "lib/sandbox.sh" || return 1
      cmd_shell "$@"
      ;;
    ls)
      _require_decl cmd_ls ls "lib/sandbox.sh" || return 1
      cmd_ls "$@"
      ;;
    ps)
      _require_decl cmd_ps ps "lib/sandbox.sh" || return 1
      cmd_ps "$@"
      ;;

    # ---- 常驻容器（由 lib/daemon.sh 提供） ----
    up)
      _require_decl cmd_up up "lib/daemon.sh 尚未就绪" || return 3
      cmd_up "$@"
      ;;
    down)
      _require_decl cmd_down down "lib/daemon.sh 尚未就绪" || return 3
      cmd_down "$@"
      ;;
    logs)
      _require_decl cmd_logs logs "lib/daemon.sh 尚未就绪" || return 3
      cmd_logs "$@"
      ;;

    # ---- 文件与包 ----
    cp)
      _require_decl cmd_cp cp "lib/sandbox.sh" || return 1
      cmd_cp "$@"
      ;;
    pkg)
      _require_decl cmd_pkg pkg "lib/sandbox.sh" || return 1
      cmd_pkg "$@"
      ;;

    # ---- 信息与配置 ----
    distros)
      _require_decl cmd_distros distros || return 1
      cmd_distros "$@"
      ;;
    config)
      _require_decl cmd_config config || return 1
      cmd_config "$@"
      ;;
    recipe)
      _require_decl cmd_recipe recipe "lib/recipe.sh" || return 1
      cmd_recipe "$@"
      ;;
    version | --version)
      cmd_version
      ;;
    *)
      log_err "未知命令: $cmd"
      printf '\n' >&2
      capbox_usage >&2
      return 2
      ;;
  esac
}

capbox_main "$@"
exit $?
